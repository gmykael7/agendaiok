# Copie para .env.assistant.local (ignorado pelo Git). Nunca use prefixo VITE_.
# Ative somente para enviar os exemplos fictícios ao OpenRouter.
ASSISTANT_LAB_ENABLED=false
ASSISTANT_LAB_OPENROUTER_KEY=
# Use um ID exato disponível no catálogo atual. Não há substituição automática.
# Owl Alpha não apareceu na consulta ao catálogo de 03/09/2026.
ASSISTANT_LAB_MODEL=liquid/lfm-2.5-2.6b:free
